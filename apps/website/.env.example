# Optional public website-analytics configuration (WEB-006).
# These are public/client-safe values that may enter the website bundle.
# Leave unset to keep the Umami integration inert — no tracker script loads
# and no website-behavior events are reported.
#
# VITE_UMAMI_HOST_URL:     base URL of the Umami instance serving /script.js
# VITE_UMAMI_WEBSITE_ID:   public website ID assigned by the Umami instance
VITE_UMAMI_HOST_URL=
VITE_UMAMI_WEBSITE_ID=

# Optional client-safe Supabase configuration (CLOUD-001).
# These are publishable values that may enter the website bundle. Leave unset
# to keep the Supabase integration inert. Never place the service-role key,
# database password, JWT secret, or any MCP credential in this file.
# VITE_SUPABASE_URL:     HTTPS endpoint of the Supabase project
# VITE_SUPABASE_ANON_KEY: publishable/anon client key for the project
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=