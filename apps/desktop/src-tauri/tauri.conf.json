{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soravo",
  "version": "0.1.0",
  "identifier": "com.soravo.desktop",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Soravo", "width": 1080, "height": 720, "minWidth": 820, "minHeight": 560 }], "security": { "csp": "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; connect-src ipc: http://ipc.localhost; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; script-src 'self'" } },
  "plugins": { "deep-link": { "desktop": { "schemes": ["soravo"] } } },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "./icons/icon.ico",
        "languages": ["English"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-layer-shell0", "libopenblas0"],
        "files": {
          "/usr/lib/Soravo": "transcribe-libs"
        }
      },
      "rpm": {
        "depends": [
          "libgtk-layer-shell.so.0()(64bit)",
          "libopenblas.so.0()(64bit)"
        ],
        "files": {
          "/usr/lib/Soravo": "transcribe-libs"
        }
      },
      "appimage": {
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      }
    }
  }
}
