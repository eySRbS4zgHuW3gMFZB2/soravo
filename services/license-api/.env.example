# Server-only payment service configuration (CLOUD-009).
#
# These variables belong EXCLUSIVELY to the server-side license-api service.
# They must NEVER be:
#   - placed in the website bundle (no VITE_* prefix)
#   - placed in the desktop application/bundle
#   - committed to Git
#   - written to logs, progress files, or screenshots
#
# PAYMENT_PROVIDER_KIND
#   Selects the payment provider implementation for the server process.
#   - `dev`       development/test-only deterministic provider. Refused when
#                 NODE_ENV=production (configuration error).
#   - `razorpay`  reserved. NOT implemented during CLOUD-009. Selecting it
#                 yields a stable `provider_not_implemented` configuration
#                 error. The real Razorpay provider arrives in CLOUD-010.
PAYMENT_PROVIDER_KIND=dev

# Reserverd for CLOUD-010 / CLOUD-011. Not read by CLOUD-009. Server-only.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=